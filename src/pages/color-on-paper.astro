---
import Layout from "../layouts/Layout.astro";

const colorOnPaper = [
  {
    image: "/coloronpaper/cherry.webp",
    title: "Cherry",
    medium: "Marker on Paper"
  },
  {
    image: "/coloronpaper/jono-jessie.webp",
    title: "Jono & Jessie",
    medium: "Mixed Media on Paper"
  },
  {
    image: "/coloronpaper/love.webp",
    title: "Love",
    medium: "Marker on Paper"
  },
  {
    image: "/coloronpaper/janji-ya-jangan-menangis-lagi.webp",
    title: "Janji Ya, Jangan Menangis Lagi",
    medium: "Poster Color"
  },
  {
    image: "/coloronpaper/sepatuku.webp",
    title: "Sepatuku",
    medium: "Watercolor on Paper"
  },
  {
    image: "/coloronpaper/burger-2022.webp",
    title: "Burger (2022)",
    medium: "Gouache on Paper"
  },
  {
    image: "/coloronpaper/pizza-2022.webp",
    title: "Pizza (2022)",
    medium: "Gouache on Paper"
  },
  {
    image: "/coloronpaper/tea.webp",
    title: "Tea",
    medium: "Watercolor on Paper"
  },
  {
    image: "/coloronpaper/blue-eyes.webp",
    title: "Blue Eyes",
    medium: "Pastel on Paper"
  },
  {
    image: "/coloronpaper/sarapan.webp",
    title: "Sarapan",
    medium: "Marker on Paper"
  }
];
---

<Layout title="Color on Paper" description="Portofolio karya warna di atas kertas">
  <section class="min-h-screen px-4 sm:px-8 md:px-20 py-12 bg-transparent">
    <div class="max-w-4xl mb-12">
      <h1 class="text-4xl sm:text-5xl font-bold mb-6 tracking-tight">
        Color on Paper
      </h1>
      <p class="text-lg md:text-2xl leading-relaxed text-gray-200">
        Koleksi ilustrasi warna dengan berbagai medium di atas kertas. Setiap karya merekam momen keseharian dengan karakter khas dan warna yang ekspresif.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {colorOnPaper.map((artwork) => (
        <figure class="group overflow-hidden rounded-3xl border-4 border-dashed border-pink-400/60 bg-white/10 backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
          <div class="relative aspect-[4/5] overflow-hidden">
            <img
              src={artwork.image}
              alt={artwork.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          </div>
          <figcaption class="px-6 py-5">
            <h3 class="text-xl font-bold tracking-tight text-white">
              {artwork.title}
            </h3>
            <p class="mt-1 text-sm uppercase tracking-widest text-pink-200">
              {artwork.medium}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12">
      <a
        href="/#works"
        class="inline-flex items-center gap-2 rounded-full bg-blue-400 px-6 py-3 font-semibold text-white transition-transform duration-300 hover:scale-105"
      >
        <i class="fas fa-arrow-left"></i>
        Kembali ke Works
      </a>
    </div>
  </section>
</Layout>



---
import Layout from "../layouts/Layout.astro";
import "../styles/animations.css";
import "../styles/galery.css";
import { colorOnPaper } from '../data/color-on-paper.astro';
---

<Layout title="Color on Paper" description="Portofolio karya warna di atas kertas" hideNav={true}>
  <section id="gallery" class="bg-transparent min-h-screen px-4 sm:px-8 md:px-20 py-12">
    <!-- Back Button -->
    <div class="mb-8 relative z-50">
      <button
      id="back-button"
      class="relative inline-flex items-center gap-3 px-6 py-3 sm:px-8 sm:py-4 text-base sm:text-lg font-bold bg-pink-500 text-white rounded-full overflow-hidden group transform transition-all duration-300 hover:scale-105 hover:bg-pink-600 cursor-pointer z-50 shadow-md"
    >
      <span class="relative z-10">
        <i class="fas fa-arrow-left"></i>
      </span>
      <span class="relative z-10 font-medium">Kembali</span>
      <span class="absolute -bottom-1 -right-1 w-6 h-6 bg-yellow-300 rounded-full z-0 sm:w-8 sm:h-8"></span>
    </button>
    </div>
    
    <!-- Scribble Header -->
    <h1 class="text-4xl sm:text-5xl font-bold mb-12 md:mb-16 tracking-tight animate-fadeIn">
      <span class="relative inline-block font-comic">
        Color on Paper
        <span class="absolute -bottom-2 xs:-bottom-3 left-0 w-full h-3 sm:h-4 bg-pink-400 z-0 opacity-30"></span>
        <div class="absolute -bottom-4 w-full flex items-center justify-center gap-1 text-pink-500">
          <i class="fas fa-wave-square text-xl sm:text-2xl"></i>
          <i class="fas fa-wave-square text-xl sm:text-2xl" style="transform: rotate(180deg);"></i>
          <i class="fas fa-wave-square text-xl sm:text-2xl"></i>
        </div>
      </span>
    </h1>
    
    <p class="text-lg md:text-2xl leading-relaxed max-w-3xl mb-12 font-comic animate-fadeIn">
      Koleksi ilustrasi warna dengan berbagai medium di atas kertas. Setiap karya merekam momen keseharian dengan karakter khas dan warna yang ekspresif.
    </p>

    <!-- Masonry Gallery -->
    <div class="gallery-container animate-slideInUp">
      <div class="masonry-container">
        {colorOnPaper.map((artwork, index) => (
          <div class="masonry-item">
            <div class="card bg-white p-3 sm:p-4 relative overflow-visible rounded-lg transform transition-all duration-300 hover:scale-105 hover:rotate-1 border-4 border-dashed"
              style={`border-color: ${['#FF6B6B', '#06D6A0', '#118AB2', '#FFD166'][index % 4]}`}>
              {(index % 3 === 0) && 
                <i class="fas fa-star absolute -top-4 -right-4 text-2xl sm:text-3xl pointer-events-none text-pink-500 animate-pulse" style="transform: rotate(45deg);"></i>
              }
              {(index % 4 === 0) && 
                <i class="far fa-circle absolute -bottom-4 -left-4 text-3xl sm:text-4xl pointer-events-none text-emerald-400 animate-pulse"></i>
              }
              <div class="relative w-full overflow-hidden rounded-lg">
                <img 
                  src={artwork.image} 
                  alt={artwork.title} 
                  class="object-cover w-full h-auto z-10 relative"
                  loading="lazy"
                />
              </div>
              <h3 class="text-base sm:text-lg md:text-xl font-bold mt-3 font-comic text-gray-900" 
                style={`transform: rotate(${(index % 2 === 0) ? '0.5deg' : '-0.5deg'}`}>
                {artwork.title}
              </h3>
              <p class="text-xs sm:text-sm mt-1 font-comic text-gray-600">
                {artwork.medium}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const backButton = document.getElementById('back-button');
      if (backButton) {
        backButton.addEventListener('click', function(e) {
          e.preventDefault();
          window.history.back();
        });
      }
    });
  </script>
</Layout>



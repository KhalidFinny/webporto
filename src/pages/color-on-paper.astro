---
import Layout from "../layouts/Layout.astro";
import "../styles/animations.css";
import "../styles/galery.css";
import { colorOnPaper } from '../data/color-on-paper.astro';
---

<Layout title="Color on Paper" description="Portofolio karya warna di atas kertas" hideNav={true}>
  <section id="gallery" class="bg-transparent min-h-screen px-4 sm:px-8 md:px-20 py-12">
    <!-- Back Button -->
    <div class="mb-6">
      <button
        onclick="window.history.back()"
        class="inline-flex items-center gap-2 text-gray-700 hover:text-gray-900 transition-colors duration-200"
      >
        <i class="fas fa-arrow-left"></i>
        <span class="font-medium">Kembali</span>
      </button>
    </div>
    
    <!-- Scribble Header -->
    <h1 class="text-4xl sm:text-5xl font-bold mb-12 md:mb-16 tracking-tight animate-fadeIn">
      <span class="relative inline-block font-comic">
        Color on Paper
        <span class="absolute -bottom-2 xs:-bottom-3 left-0 w-full h-3 sm:h-4 bg-pink-400 z-0 opacity-30"></span>
        <svg class="absolute -bottom-4 w-full" viewBox="0 0 200 15" preserveAspectRatio="none">
          <path d="M0,5 Q25,15 50,5 T100,5 T150,5 T200,5" stroke="#FF6B6B" stroke-width="4" fill="none" 
            class="animate-draw" stroke-linecap="round" stroke-dasharray="300" stroke-dashoffset="300" />
        </svg>
      </span>
    </h1>
    
    <p class="text-lg md:text-2xl leading-relaxed max-w-3xl mb-12 font-comic animate-fadeIn">
      Koleksi ilustrasi warna dengan berbagai medium di atas kertas. Setiap karya merekam momen keseharian dengan karakter khas dan warna yang ekspresif.
    </p>

    <!-- Masonry Gallery -->
    <div class="gallery-container animate-slideInUp">
      <div class="masonry-container">
        {colorOnPaper.map((artwork, index) => (
          <div class="masonry-item">
            <div class="card bg-white p-3 sm:p-4 relative overflow-hidden rounded-lg transform transition-all duration-300 hover:scale-105 hover:rotate-1 border-4 border-dashed"
              style={`border-color: ${['#FF6B6B', '#06D6A0', '#118AB2', '#FFD166'][index % 4]}`}>
              {(index % 3 === 0) && 
                <svg class="absolute -top-4 -right-4 w-8 sm:w-10 h-8 sm:h-10 pointer-events-none" viewBox="0 0 100 100">
                  <path d="M80,20 Q60,40 80,60" stroke="#FF6B6B" stroke-width="2" fill="none" class="animate-draw-slow" />
                </svg>
              }
              {(index % 4 === 0) && 
                <svg class="absolute -bottom-4 -left-4 w-8 sm:w-12 h-8 sm:h-12 pointer-events-none" viewBox="0 0 100 100">
                  <circle cx="50" cy="50" r="30" stroke="#06D6A0" stroke-width="2" fill="none" class="animate-draw-slow" />
                </svg>
              }
              <div class="relative w-full overflow-hidden rounded-lg">
                <img 
                  src={artwork.image} 
                  alt={artwork.title} 
                  class="object-cover w-full h-auto z-10 relative"
                  loading="lazy"
                />
                <div class="absolute bottom-3 right-3 bg-white p-2 rounded-full shadow-md">
                  <i class="fas fa-expand text-blue-400"></i>
                </div>
              </div>
              <h3 class="text-base sm:text-lg md:text-xl font-bold mt-3 font-comic text-gray-900" 
                style={`transform: rotate(${(index % 2 === 0) ? '0.5deg' : '-0.5deg'}`}>
                {artwork.title}
              </h3>
              <p class="text-xs sm:text-sm mt-1 font-comic text-gray-600">
                {artwork.medium}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>


